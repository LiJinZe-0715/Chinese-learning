{
  "name": "chinese-japanese",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint src tests scripts vite.config.ts",
    "format": "oxfmt src tests scripts vite.config.ts index.html README.md",
    "test": "node --test tests/*.test.ts && node scripts/check-curriculum.mjs",
    "check": "pnpm lint && pnpm test && pnpm build",
    "content:build": "python scripts/build-curriculum.py && node scripts/build-glossary.mjs",
    "android:build": "node scripts/build-android.mjs",
    "android:test": "node --test android/tests/*.test.mjs",
    "android:publish": "node scripts/publish-android.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.61.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
